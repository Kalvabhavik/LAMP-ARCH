# Supabase — get local values with `npx supabase status` after `npx supabase start`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for mission submissions (created by the migration)
SUPABASE_SUBMISSIONS_BUCKET=submissions

# Game flow URLs (all optional; defaults shown)
NEXT_PUBLIC_MAGIC_BOX_EXTERNAL_URL=/portal
NEXT_PUBLIC_STARTING_PAGE_URL=/register
NEXT_PUBLIC_INTRODUCTION_URL=/portal?section=introduction
NEXT_PUBLIC_RETURN_TO_GAME_URL=/play

# Optional AI tutor (existing feature)
OPENAI_API_KEY=
OPENAI_MODEL=
